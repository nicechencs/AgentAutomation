# User supplies these values locally; no actual secrets belong in this file.
# Copy to deploy/.env and fill privately before using Compose.
# Keep N8N_ENCRYPTION_KEY fixed across restarts and preserve it with n8n backups.
N8N_ENCRYPTION_KEY=
RUNNER_TOKEN=
WORKFLOW_TOKEN=
# Optional: use 8001 while the host preview is still running on 8000.
RUNNER_HTTP_PORT=8000
